generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemCheck {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                  String               @id @default(cuid())
  email               String
  emailNormalized     String               @unique
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordCredential  PasswordCredential?
  profile             EncryptedProfile?
  sessions            Session[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  statementImports    StatementImport[]
  accounts            Account[]
  categories          Category[]
  categoryRules       CategoryRule[]
  transactions        Transaction[]
  duplicateCandidates DuplicateCandidate[]
  categorySuggestions CategorySuggestion[]
  categoryFeedback    CategoryFeedback[]
  budgets             Budget[]
  goals               FinancialGoal[]
  subscriptions       Subscription[]
  financeAnswers      FinanceAnswer[]
}

model FinanceAnswer {
  id            String            @id @default(cuid())
  userId        String
  question      String
  answer        String
  currency      String            @db.VarChar(3)
  periodStart   DateTime          @db.Date
  model         String
  promptVersion String
  factsHash     String
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations     FinanceCitation[]

  @@index([userId, createdAt])
}

model FinanceCitation {
  id         String        @id @default(cuid())
  answerId   String
  factId     String
  label      String
  sourceType String
  sourceId   String?
  valueMinor BigInt?
  answer     FinanceAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, factId])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  currency     String        @db.VarChar(3)
  timeZone     String        @default("UTC")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id                String               @id @default(cuid())
  userId            String?
  name              String
  slug              String
  color             String               @default("slate")
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  user              User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  rules             CategoryRule[]
  suggestions       CategorySuggestion[]
  feedback          CategoryFeedback[]
  budgetAllocations BudgetAllocation[]

  @@unique([userId, slug])
  @@index([userId, active])
}

model Budget {
  id              String             @id @default(cuid())
  userId          String
  name            String
  month           DateTime           @db.Date
  currency        String             @db.VarChar(3)
  totalLimitMinor BigInt
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations     BudgetAllocation[]

  @@unique([userId, month, currency])
  @@index([userId, month])
}

model BudgetAllocation {
  id         String   @id @default(cuid())
  budgetId   String
  categoryId String
  limitMinor BigInt
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model FinancialGoal {
  id           String     @id @default(cuid())
  userId       String
  name         String
  targetMinor  BigInt
  currentMinor BigInt     @default(0)
  currency     String     @db.VarChar(3)
  targetDate   DateTime?  @db.Date
  status       GoalStatus @default(ACTIVE)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, targetDate])
}

enum SubscriptionCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  merchant           String
  normalizedMerchant String
  amountMinor        BigInt
  currency           String              @db.VarChar(3)
  cadence            SubscriptionCadence
  nextChargeDate     DateTime            @db.Date
  active             Boolean             @default(true)
  source             String              @default("USER")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedMerchant, amountMinor, currency, cadence])
  @@index([userId, active, nextChargeDate])
}

enum CategorySource {
  USER
  USER_RULE
  MERCHANT_HISTORY
  PLATFORM_RULE
  AI
  UNCATEGORIZED
}

enum ReviewStatus {
  PENDING
  REVIEWED
  POSSIBLE_DUPLICATE
}

model Transaction {
  id                    String               @id @default(cuid())
  userId                String
  accountId             String
  importId              String?
  sourceRowNumber       Int?
  sourceTransactionId   String?
  amountMinor           BigInt
  currency              String               @db.VarChar(3)
  postedDate            DateTime
  description           String
  normalizedDescription String
  fingerprint           String
  fingerprintVersion    Int                  @default(1)
  categoryId            String?
  categorySource        CategorySource       @default(UNCATEGORIZED)
  categoryConfidence    Float?
  reviewStatus          ReviewStatus         @default(PENDING)
  version               Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  import                StatementImport?     @relation(fields: [importId], references: [id], onDelete: SetNull)
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  suggestions           CategorySuggestion[]

  @@unique([importId, sourceRowNumber])
  @@unique([accountId, sourceTransactionId])
  @@index([userId, postedDate, id])
  @@index([userId, reviewStatus, postedDate])
  @@index([accountId, fingerprint])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model CategorySuggestion {
  id                  String             @id @default(cuid())
  userId              String
  transactionId       String
  suggestedCategoryId String?
  confidence          Float
  explanation         String
  model               String
  promptVersion       String
  groundedInputHash   String
  status              SuggestionStatus   @default(PENDING)
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction         Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  suggestedCategory   Category?          @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  feedback            CategoryFeedback[]

  @@index([userId, transactionId, createdAt])
  @@index([status, createdAt])
}

model CategoryFeedback {
  id           String             @id @default(cuid())
  userId       String
  suggestionId String
  accepted     Boolean
  categoryId   String?
  reason       String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion   CategorySuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, suggestionId])
  @@index([userId, createdAt])
}

enum RuleMatchType {
  DESCRIPTION_EXACT
  DESCRIPTION_CONTAINS
  DEBIT
  CREDIT
}

model CategoryRule {
  id         String        @id @default(cuid())
  userId     String
  categoryId String
  matchType  RuleMatchType
  pattern    String?
  priority   Int           @default(100)
  active     Boolean       @default(true)
  version    Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, active, priority])
}

enum DuplicateResolution {
  PENDING
  KEEP_BOTH
  MERGED
  NOT_DUPLICATE
}

model DuplicateCandidate {
  id          String              @id @default(cuid())
  userId      String
  leftId      String
  rightId     String
  resolution  DuplicateResolution @default(PENDING)
  canonicalId String?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leftId, rightId])
  @@index([userId, resolution, createdAt])
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model StatementImport {
  id               String        @id @default(cuid())
  userId           String
  checksum         String
  objectKey        String        @unique
  originalFileName String
  contentType      String
  sizeBytes        Int
  status           ImportStatus  @default(QUEUED)
  requestId        String
  rowCount         Int?
  failureReason    String?
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@unique([userId, checksum])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  passwordSalt String
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EncryptedProfile {
  userId     String @id
  ciphertext String
  nonce      String
  authTag    String
  keyVersion Int    @default(1)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  requestId   String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
